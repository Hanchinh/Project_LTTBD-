# =============================================================================
# Root .gitignore for Delivery Location Marker System (App-Only)
# =============================================================================

# Operating System & Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.idea/
*.iml
*.ipr
*.iws
.vscode/settings.json

# Environment & Credentials (NEVER commit secrets, tokens, credentials, private keys)
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert
*.p12
*.jks
*.keystore

# Android Keystore and signing properties
key.properties
**/key.properties
!key.properties.example
!**/key.properties.example

# Logs, Cache & Test Reports
logs/
*.log
coverage/
.nyc_output/

# Build & Ephemeral Directories
build/
**/build/
.gradle/
**/.gradle/

# Flutter Mobile Build & Cache Artifacts
mobile_app/.dart_tool/
mobile_app/.pub/
mobile_app/.pub-cache/
mobile_app/build/
mobile_app/.flutter-plugins
mobile_app/.flutter-plugins-dependencies
mobile_app/ios/Flutter/.last_build_id
mobile_app/ios/Flutter/ephemeral/
mobile_app/macos/Flutter/ephemeral/
mobile_app/android/app/debug
mobile_app/android/app/profile
mobile_app/android/app/release
mobile_app/.widget_preview/

# NOTE: Lockfiles (mobile_app/pubspec.lock) are deliberately TRACKED.

# Archive & Database Artifacts
*.apk
*.dump
*.zip
*.sql
backups/
/backup_*
*.dbackup

# Preserved/Untracked local folders from server branches (when switching branches)
admin_web/
backend/
node_modules/
dist/



# impeccable-start
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/*.png
**/.impeccable/live/**
**/.impeccable/questions/**
# impeccable-end